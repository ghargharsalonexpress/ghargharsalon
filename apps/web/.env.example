# Copy to .env.local to change these (never commit .env.local).
# Staging build: VITE_API_URL=https://api.staging.brand.in   Production: https://api.brand.in
VITE_API_URL=http://localhost:4000
# Where photos are served: the API's /media in development, the CloudFront media URL in production.
VITE_MEDIA_URL=http://localhost:4000/media
# Google Maps JavaScript API key (browser key, restricted to the site). Empty: no map, the phone's location still works.
VITE_GOOGLE_MAPS_KEY=
# The professionals' application form (e.g. a Google Form). Empty: the Join page offers "Apply by email".
VITE_PRO_FORM_URL=
# Optional: 1 keeps the style guide in a production build; 1 reports errors from a dev build.
# VITE_SHOW_STYLEGUIDE=1
# VITE_REPORT_ERRORS=1
# Optional: a release name sent with error reports, e.g. the git commit.
# VITE_RELEASE=
