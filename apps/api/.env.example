# Copy to .env for local development (never commit .env).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# `npm run db` prints this URI (local replica set on port 27018).
MONGODB_URI=mongodb://127.0.0.1:27018/brand?replicaSet=rs0

# At least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
CSRF_SECRET=change-me-too-change-me-too-change-me-too

# The web app's origin(s), comma-separated. Production: https://brand.in
WEB_ORIGINS=http://localhost:5174
# Used to build links in emails.
WEB_URL=http://localhost:5174
# Production only: .brand.in so brand.in and api.brand.in share the session cookie.
# COOKIE_DOMAIN=.brand.in
# Production behind Caddy: 1
TRUST_PROXY=0

BRAND_NAME=Ghar Ghar Salon Express
SUPPORT_EMAIL=support@brand.in
SUPPORT_PHONE=+91 00000 00000

# log: emails are logged and written to .mail/ (open the .html files). ses: Amazon SES.
EMAIL_TRANSPORT=log
EMAIL_FROM=Brand <no-reply@brand.in>
EMAIL_LOG_DIR=.mail
AWS_REGION=ap-south-1

# Admin created by `npm run seed:admin`.
ADMIN_EMAIL=admin@brand.in
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_NAME=Admin
ADMIN_PHONE=9000000000

# Web Push (VAPID) for professional job alerts (plan C10). Generate once per environment:
#   npx web-push generate-vapid-keys
# PUSH_TRANSPORT: webpush (real alerts), log (development without keys), memory (tests).
PUSH_TRANSPORT=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@brand.in

# Photos (services, professionals). local: a folder served at /media. Production: s3 + a bucket.
MEDIA_STORAGE=local
MEDIA_DIR=.data/media
MEDIA_BASE_URL=http://localhost:4000/media
# Live: MEDIA_STORAGE=imagekit, MEDIA_BASE_URL=https://ik.imagekit.io/<your-id>, and the private
# key from ImageKit > Developer options > API keys. The web needs VITE_MEDIA_MODE=imagekit too.
# IMAGEKIT_PRIVATE_KEY=

# Payments. fake: a local test payment sheet. Production: razorpay with all three values.
PAYMENT_PROVIDER=fake
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Printed on GST invoices. Production needs a valid GSTIN.
SELLER_NAME=[Company legal name]
SELLER_ADDRESS=[Registered office address]
SELLER_GSTIN=[GSTIN]

# Test helpers stay off; production refuses TEST_ROUTES=1 or CHECKOUT_RATE_LIMITS=0.
# TEST_ROUTES=0
# CHECKOUT_RATE_LIMITS=1
