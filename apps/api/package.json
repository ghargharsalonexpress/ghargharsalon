{
  "name": "@brand/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST + real-time API: auth, sessions, settings, audit (plan Part C).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db": "tsx scripts/dev-db.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "seed:catalog": "tsx --env-file-if-exists=.env scripts/seed-catalog.ts",
    "seed:site": "tsx --env-file-if-exists=.env scripts/seed-site.ts",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "seed:load": "tsx --env-file-if-exists=.env scripts/seed-load.ts",
    "migrate:otp-login": "tsx --env-file-if-exists=.env scripts/migrate-otp-login.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@node-rs/argon2": "^2.2.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "~7.6.0",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
